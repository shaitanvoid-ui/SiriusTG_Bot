# Build context allowlist. Secrets, runtime data and local tooling never reach
# the Docker daemon or an image layer.
**

!.dockerignore
!Dockerfile
!requirements.txt
!requirements-dev.txt
!requirements.lock
!requirements-dev.lock
!pytest.ini
!alembic.ini
!main.py

!docker/
!docker/**
!bot/
!bot/**
!core/
!core/**
!db/
!db/**
!locales/
!locales/**
!migrations/
!migrations/**
!ml/
!ml/**
!services/
!services/**
!userbot/
!userbot/**
!utils/
!utils/**
!workers/
!workers/**
!tests/
!tests/**

**/__pycache__/
**/*.pyc
