# --- App ---
ENV=production
LOG_LEVEL=INFO

# --- Bot ---
BOT_TOKEN=
OWNER_ID=
ADMIN_IDS=
LOG_CHANNEL_ID=

# --- DB ---
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
FSM_STORAGE_PATH=./data/fsm.db

# --- Crypto (encrypted fields, Telethon sessions and database backups) ---
# Safe generation without key output: see scripts/init_env.py and README.md
FERNET_KEY=

# --- Telethon (userbot) ---
TG_API_ID=
TG_API_HASH=
USERBOT_PHONE=
BACKUP_USERBOT_PHONE=

# --- Health-check ---
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# --- Modern Telegram interface ---
RICH_MESSAGES=true
# Concurrent updates are bounded to protect SQLite and API connections.
POLLING_CONCURRENCY=32

# Pin selected sender ID after the first verified interactive login.
# OWNER_ID remains the administrator of the bot and may be another account.
USERBOT_ACCOUNT_ID=
